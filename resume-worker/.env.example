# ApplyPilot résumé worker — copy to .env and fill in.

# Port the worker listens on (Cloudflare Tunnel points a subdomain here).
PORT=8787

# Shared secret. The Netlify app sends `Authorization: Bearer <WORKER_SECRET>`.
# Must match RESUME_WORKER_SECRET in the Netlify env. Use a long random string.
WORKER_SECRET=

# Supabase (service role — server-only, never ships to a browser).
SUPABASE_URL=https://ftrakpebzcabztwyunum.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for generated PDFs (created by migration 0019).
RESUMES_BUCKET=resumes

# ── Claude subscription mode (ADR 0042) ──────────────────────────────────────
# Lets AI tasks run on your Claude Pro/Max plan via the Agent SDK instead of a paid
# API key (selected per task in the app: Settings → AI Models → "Claude subscription").
# One-time setup on THIS machine:
#   1) npm i -g @anthropic-ai/claude-code   (the CLI the SDK drives)
#   2) claude /login  (or `claude setup-token`)  — log in as ACCOUNT 1
# Account 1 uses that default login automatically; nothing needs to go below for it.
# IMPORTANT: do NOT set ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN in this worker's
# environment — they take precedence over the subscription and would bill the API.
# (The worker still uses Anthropic *vault* keys for API-mode tasks; those are passed
#  to the API directly, not via these env vars.)
# Optional: explicit path to the `claude` binary if auto-resolution fails.
# CLAUDE_CLI_PATH=
# Optional headless token for account 1 instead of an interactive login:
# CLAUDE_CODE_OAUTH_TOKEN=

# ── Multiple Claude accounts (double the monthly Agent-SDK credit) ────────────
# Each account is an isolated CLAUDE_CONFIG_DIR with its own login (the official /
# Meridian pattern). Set up a 2nd account once, in a browser, on THIS machine:
#   CLAUDE_CONFIG_DIR=~/.claude-acct2 claude     # then /login as ACCOUNT 2
# The worker AUTO-DETECTS ~/.claude-acctN once it exists — no var needed below.
# Then switch / fail over:
#   CLAUDE_ACTIVE_ACCOUNT picks which account is TRIED FIRST (default 1); the others
#   are automatic failover when the active one hits its monthly cap.
#   Or run ./switch-account.sh 2   (sets it + restarts the worker).
# CLAUDE_ACTIVE_ACCOUNT=1
# Optional overrides (only if you don't use the default ~/.claude-acctN dirs / want a
# headless token per account):
# CLAUDE_CONFIG_DIR_2=/Users/you/.claude-acct2
# CLAUDE_CODE_OAUTH_TOKEN_2=sk-ant-oat01-…

# ── ChatGPT subscription mode via Codex SDK (ADR 0069) ───────────────────────────
# Lets any of the three AI lanes run on the ChatGPT plan without an OpenAI API key.
# The official Codex SDK + bundled CLI are installed by `npm install` in this folder.
# Recommended one-time isolated login on THIS machine:
#   mkdir -p "$HOME/.applypilot-codex"
#   CODEX_HOME="$HOME/.applypilot-codex" ./node_modules/.bin/codex login
#   CODEX_HOME="$HOME/.applypilot-codex" ./node_modules/.bin/codex login status
# Put the ABSOLUTE directory below (dotenv does not expand $HOME). If omitted, the
# worker uses the process's existing CODEX_HOME or ~/.codex login.
# CHATGPT_CODEX_HOME=/Users/you/.applypilot-codex
# Multi-user fork only: UUID-specific device logins default to
# backend/data/chatgpt-users. Override the root only when operations require it.
# CHATGPT_USER_CONFIG_ROOT=/absolute/private/path/chatgpt-users
# CHATGPT_CODEX_CLI_PATH=/absolute/path/to/resume-worker/node_modules/.bin/codex
# Keep reasoning low for these single-shot score/tailor/chat completions (default: low).
# CODEX_REASONING_EFFORT=low
# Optional timeout override; default 160000 ms.
# CODEX_SDK_TIMEOUT_MS=160000
# OPENAI_API_KEY/CODEX_API_KEY/CODEX_ACCESS_TOKEN/base-url overrides are stripped from Codex subprocesses
# in this mode, so a subscription selection cannot silently bill the API.
