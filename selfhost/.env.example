# ApplyPilot self-hosted Supabase — copy to .env, then run:
#   node scripts/generate-keys.mjs     # fills every <generated> below
#
# NEVER commit .env. The JWT_SECRET/keys here are what the Netlify app and the
# worker authenticate with once cut over.

############
# Secrets — all filled by scripts/generate-keys.mjs
############
POSTGRES_PASSWORD=<generated>
JWT_SECRET=<generated>
ANON_KEY=<generated>
SERVICE_ROLE_KEY=<generated>
PG_META_CRYPTO_KEY=<generated>

############
# Public URL — the Tailscale Funnel hostname once enabled on the server laptop
# (e.g. https://server-laptop.tailXXXX.ts.net). For local phase-0 testing:
# http://127.0.0.1:8000
############
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
API_EXTERNAL_URL=http://127.0.0.1:8000
SITE_URL=http://127.0.0.1:8000

############
# Database
############
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=54322          # host bind (127.0.0.1) for psql/migrations/backups

############
# Ports (all bind 127.0.0.1; Funnel is the only public door)
############
KONG_BIND_ADDRESS=127.0.0.1
KONG_HTTP_PORT=8000
STUDIO_PORT=3001

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
JWT_EXPIRY=3600

############
# Zero-touch layer (all optional; blank = feature off)
############
# healthchecks.io ping URLs — create three checks and paste their URLs:
HC_PING_WATCHDOG=
HC_PING_BACKUP=
HC_PING_AUTOPULL=
# Second backup location (default iCloud Drive if it exists):
BACKUP_DEST2=

############
# Unused-but-required stubs (storage tenant naming etc.)
############
STORAGE_TENANT_ID=stub
GLOBAL_S3_BUCKET=stub
REGION=local
STUDIO_DEFAULT_ORGANIZATION=ApplyPilot
STUDIO_DEFAULT_PROJECT=ApplyPilot
OPENAI_API_KEY=
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=
ADDITIONAL_REDIRECT_URLS=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
