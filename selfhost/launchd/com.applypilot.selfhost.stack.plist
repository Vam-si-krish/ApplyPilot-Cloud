<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.applypilot.selfhost.stack</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>sleep 20 &amp;&amp; cd __SELFHOST__ &amp;&amp; /usr/local/bin/docker compose up -d</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__SELFHOST__/logs/stack.out.log</string>
  <key>StandardErrorPath</key><string>__SELFHOST__/logs/stack.err.log</string>
</dict>
</plist>
