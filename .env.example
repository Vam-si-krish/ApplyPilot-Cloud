# ─── ApplyPilot-Cloud environment ───────────────────────────────────────────
# Copy to .env.local for local dev. In production set these in Netlify.
# NEVER commit real secrets.

# ── Independent backend (multi-user-fork; preferred) ─────────────────────────
BACKEND_URL=https://vamsis-macbook-pro.tail579e6c.ts.net/jobpilot
BACKEND_SERVICE_KEY=paste-the-generated-service-key-from-backend/.env
RESUME_WORKER_URL=https://vamsis-macbook-pro.tail579e6c.ts.net/jobpilot/worker
RESUME_WORKER_SECRET=paste-the-generated-worker-secret-from-backend/.env

# With BACKEND_URL set, worker configuration is deployment-managed: users cannot
# reveal or override these values in Settings (ADR 0075).

# ── Legacy production backend (do not set for multi-user-fork) ───────────────
# Project URL and keys from the Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key bypasses RLS — server-side ONLY, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Auth (three fixed private accounts; ADR 0073) ────────────────────────────
# Server-only JSON. IDs must match migration 0044; passwords must be 10+ chars.
APP_USERS_JSON=[{"id":"00000000-0000-4000-8000-000000000001","username":"vamsi","password":"replace-owner-password"},{"id":"00000000-0000-4000-8000-000000000002","username":"surya","password":"replace-surya-password"},{"id":"00000000-0000-4000-8000-000000000003","username":"samitha","password":"replace-samitha-password"}]
# Secret used to sign the session cookie. Generate: openssl rand -hex 32
AUTH_SECRET=generate-with-openssl-rand-hex-32

# ── Apify (job fetching) ─────────────────────────────────────────────────────
# Token from https://console.apify.com/account/integrations.
# Legacy deployment fallback only. The managed fork requires each user to add a key in
# Settings; deployment fallback is disabled there.
APIFY_TOKEN=apify_api_xxx
# Default actor (overridable per-user in Settings). LinkedIn jobs scraper.
APIFY_ACTOR_ID=bebity~linkedin-jobs-scraper

# ── Cron auth ────────────────────────────────────────────────────────────────
# Netlify schedules send this as a Bearer token to /api/run. Generate a random value.
CRON_SECRET=generate-with-openssl-rand-hex-32

# ── LLM provider (scoring) ───────────────────────────────────────────────────
# Legacy deployment fallback only. The managed fork uses the logged-in user's saved
# provider key or their UUID-isolated subscription connection.
GEMINI_API_KEY=your-gemini-key
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# Optional overrides:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used to build the Apify webhook URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional worker path for UUID-isolated Claude subscription logins. Defaults to
# backend/data/claude-users (gitignored and covered by the backend backup job).
# CLAUDE_USER_CONFIG_ROOT=/absolute/private/path/claude-users
# Optional worker path for UUID-isolated ChatGPT/Codex device logins. Defaults to
# backend/data/chatgpt-users (gitignored and covered by the backend backup job).
# CHATGPT_USER_CONFIG_ROOT=/absolute/private/path/chatgpt-users
# Optional pinned Codex CLI override; normally use resume-worker/node_modules/.bin/codex.
# CHATGPT_CODEX_CLI_PATH=/absolute/path/to/codex
