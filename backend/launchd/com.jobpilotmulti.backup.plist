<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jobpilotmulti.backup</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string><string>__BACKEND__/scripts/backup.sh</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>45</integer></dict>
  <key>StandardOutPath</key><string>__BACKEND__/logs/backup.out.log</string>
  <key>StandardErrorPath</key><string>__BACKEND__/logs/backup.err.log</string>
</dict></plist>
